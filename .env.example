# Copy to .env before running `docker compose up`. Never commit the real .env.

# HMAC-SHA256 signing key for access tokens. Must be at least 32 bytes; the
# backend refuses to start without it so a deploy can never fall back to a
# well-known key. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-bytes-of-random-data

# Shared secret between the Java backend and the Python analytics service.
# The analytics service fails closed when it is unset.
#   openssl rand -hex 32
ANALYTICS_INTERNAL_TOKEN=replace-me-with-a-random-token

# PostgreSQL password for the autocare role.
DATABASE_PASSWORD=autocare

# Password of the seeded demo account (demo@autocare.dev), created only when
# the "demo" Spring profile is active.
DEMO_USER_PASSWORD=DemoAutoCare123

# Spring profiles. Defaults to "demo" in docker-compose.yml, which seeds
# fictional data on first boot. Leave empty for an empty database.
# SPRING_PROFILES_ACTIVE=
