# Rendered to /etc/nginx/conf.d/default.conf at container start by the official
# nginx entrypoint, which runs envsubst over /etc/nginx/templates/*.template.
#
# Only PORT and BACKEND_URL are substituted (NGINX_ENVSUBST_FILTER in the
# Dockerfile restricts it), so nginx's own $uri, $host and $scheme survive.
# Both have defaults matching docker-compose.yml, so the local stack is
# unaffected; on Railway they carry the assigned port and the backend's
# private address.
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Platform health probe. Answered by nginx itself so it stays up even when
    # the backend is still starting.
    location = /health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # Hashed asset filenames are immutable, so they can be cached hard.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # The API is proxied through the same origin as the SPA. That keeps the
    # HttpOnly refresh cookie first-party, exactly like the Vite dev proxy,
    # so no cross-site cookie handling is needed in production either.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # Client-side routing: unknown paths must return index.html, never a 404,
    # or a refresh on /app/vehicles would break.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # index.html itself must never be cached, otherwise a deploy would keep
    # serving references to asset hashes that no longer exist.
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
}
